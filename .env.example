# Hosted values belong in runtime settings. Never commit real credentials.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Existing pilot secrets are retained independently:
DRIOZ_OWNER_EMAIL=
TRIP_PIN_SECRET=

# Domain-restricted public browser key, stored in hosted runtime settings.
GOOGLE_MAPS_BROWSER_KEY=

# Vercel server-only staging configuration. Never prefix these with NEXT_PUBLIC_ or EXPO_PUBLIC_.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=drioz-documents-staging

